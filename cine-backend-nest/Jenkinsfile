pipeline {
  agent any

  tools {
    nodejs 'NodeJS 20'
  }

  environment {
    CI = 'true'
    HUSKY = '0'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
  }

  triggers {
    pollSCM('H/2 * * * *')
  }

  stages {
    stage('Install') {
      steps {
        dir('cine-backend-nest') {
          sh 'npm ci'
        }
      }
    }

    stage('Lint and test') {
      steps {
        dir('cine-backend-nest') {
          sh 'npm run lint'
          sh 'npm run test:cov'
        }
      }
    }

    stage('Build') {
      steps {
        dir('cine-backend-nest') {
          sh 'npm run build'
        }
      }
    }

    stage('SonarQube analysis') {
      steps {
        script {
          def scannerHome = tool 'SonarScanner'
          withSonarQubeEnv('SonarQube') {
            dir('cine-backend-nest') {
              sh "${scannerHome}/bin/sonar-scanner"
            }
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate abortPipeline: true
        }
      }
    }
  }

  post {
    success {
      echo 'Pipeline OK'
    }
    failure {
      echo 'Pipeline failed; inspect the failed stage.'
    }
  }
}
